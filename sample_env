# Everything below is optional. Repo, token and servers can all be set in the UI.
# PORT=8086
# SERVER_BRANCHES=staging production      # default list for the sidebar (space or comma separated)
# GIT_BASE_DIRECTORY=/path/to/clones/     # default repo = GIT_BASE_DIRECTORY + REPO (else the current directory)
# REPO=my-repo
# GITHUB_ACCESS_TOKEN=                    # otherwise `gh auth token` is used
# STORE_DIR=/path/to/folder               # where the encrypted server-list file is kept (default: ./.cherrypicker-data)
